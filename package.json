{
  "name": "spartan-compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:db": "docker compose -f docker/compose.dev.yml up -d && next dev --turbo && docker compose -f compose.dev.yml down",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:start": "docker compose -f docker/compose.dev.yml up -d",
    "db:stop": "docker compose -f docker/compose.dev.yml down",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:drop": "drizzle-kit drop --config drizzle.config.ts",
    "db:seed": "tsx ./src/lib/db/seed.ts",
    "db:insert": "tsx ./src/lib/db/insert.ts",
    "db:insert:bun": "bun ./src/lib/db/insert.ts",
    "scraper:test": "tsx ./scraper/test.ts",
    "scraper:test:bun": "bun ./scraper/test.ts"
  },
  "dependencies": {
    "arctic": "^2.3.4",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0-beta.2",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.39",
    "@types/pg": "^8.12.0",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "babel-plugin-react-compiler": "^0.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.3.2",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.447.0",
    "next": "15.3.2",
    "next-themes": "^0.3.0",
    "postcss": "^8.5.3",
    "prettier": "3.3.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.5",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3"
  }
}
