{
  "name": "spartan-compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:start": "docker compose -f compose.dev.yml up -d",
    "db:stop": "docker compose -f compose.dev.yml down",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:drop": "drizzle-kit drop --config drizzle.config.ts",
    "db:seed": "tsx ./src/lib/db/seed.ts",
    "scraper:test": "tsx ./scraper/test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
